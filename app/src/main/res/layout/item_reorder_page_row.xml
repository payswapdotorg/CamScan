<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_vertical"
android:orientation="horizontal"
android:paddingStart="16dp"
android:paddingEnd="8dp"
android:paddingTop="8dp"
android:paddingBottom="8dp">

<TextView
android:id="@+id/reorder_row_label"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_weight="1"
android:textAppearance="?attr/textAppearanceBody1" />

<com.google.android.material.button.MaterialButton
android:id="@+id/document_row_move_up"
style="@style/Widget.MaterialComponents.Button.TextButton"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="@string/workspace_reorder_move_up" />

<com.google.android.material.button.MaterialButton
android:id="@+id/document_row_move_down"
style="@style/Widget.MaterialComponents.Button.TextButton"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="@string/workspace_reorder_move_down" /></LinearLayout>
