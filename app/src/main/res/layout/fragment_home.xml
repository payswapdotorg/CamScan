<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical">

<androidx.appcompat.widget.Toolbar
android:id="@+id/home_toolbar"
android:layout_width="match_parent"
android:layout_height="?attr/actionBarSize"
android:background="?attr/colorPrimary"
app:title="@string/workspace_app_title"
app:titleTextColor="?attr/colorOnPrimary" />

<TextView
android:id="@+id/home_recent_header"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:paddingStart="16dp"
android:paddingEnd="16dp"
android:paddingTop="16dp"
android:paddingBottom="8dp"
android:text="@string/workspace_home_recent_header"
android:textAppearance="?attr/textAppearanceSubtitle1"
android:visibility="gone" />

<FrameLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1">

<androidx.recyclerview.widget.RecyclerView
android:id="@+id/home_recent_list"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:clipToPadding="false"
android:paddingBottom="8dp"
android:visibility="gone" />

<LinearLayout
android:id="@+id/home_empty_state"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:gravity="center"
android:orientation="vertical"
android:padding="32dp">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:gravity="center"
android:text="@string/workspace_home_empty_message"
android:textAppearance="?attr/textAppearanceBody1" />
</LinearLayout>
</FrameLayout>

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="16dp">

<com.google.android.material.button.MaterialButton
android:id="@+id/home_new_scan_button"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="@string/workspace_home_new_scan" />

<com.google.android.material.button.MaterialButton
android:id="@+id/home_open_library"
style="@style/Widget.MaterialComponents.Button.TextButton"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="@string/workspace_home_open_library" />

<!-- CAMSCAN-VERIFY-002: batch-selection + settings entries (additive). -->
<com.google.android.material.button.MaterialButton
android:id="@+id/home_batch_select_button"
style="@style/Widget.MaterialComponents.Button.TextButton"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="@string/workspace_home_batch_select" />

<com.google.android.material.button.MaterialButton
android:id="@+id/home_settings_button"
style="@style/Widget.MaterialComponents.Button.TextButton"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="@string/workspace_home_settings" />
</LinearLayout></LinearLayout>
