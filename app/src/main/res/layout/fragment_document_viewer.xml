<?xml version="1.0" encoding="utf-8"?>
<!-- CAMSCAN-VERIFY-001: the root becomes a FrameLayout holding the prior
     vertical viewer content (id viewer_content; every existing child and id
     is unchanged) plus the PIN unlock overlay (document_unlock_overlay) and
     the five-entry viewer tools row (viewer_tool_*). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/viewer_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<androidx.appcompat.widget.Toolbar
    android:id="@+id/viewer_toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="?attr/colorPrimary"
    app:navigationIcon="?attr/homeAsUpIndicator"
    app:title="@string/workspace_document_detail_title"
    app:titleTextColor="?attr/colorOnPrimary" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/document_detail_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/document_edit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/workspace_edit_title"
        android:textAppearance="?attr/textAppearanceButton"
        android:textColor="?attr/colorPrimary" />
</LinearLayout>

<TextView
    android:id="@+id/document_page_indicator"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingBottom="8dp"
    android:textAppearance="?attr/textAppearanceBody2"
    android:textColor="?android:attr/textColorSecondary" />

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/document_pages_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/document_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/workspace_viewer_empty_message"
            android:textAppearance="?attr/textAppearanceBody1" />
    </LinearLayout>
</FrameLayout>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_reorder_pages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_reorder_pages" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_page_delete"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_page_delete" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_detail_delete"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_document_detail_delete" />
</LinearLayout>

<!-- CAMSCAN-PROD-008: merge/append/split affordance row (stable semantic ids
     document_merge_button, document_append_import_button,
     document_split_button; same button pattern as the rows above). -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_merge_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_document_merge" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_append_import_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_document_append_import" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_split_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_document_split" />
</LinearLayout>

<!-- CAMSCAN-PROD-007: export affordance row (same button pattern as the row
     above; stable semantic ids document_export_pdf_button,
     document_export_jpg_button, document_share_button). -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_export_pdf_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_export_pdf" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_export_jpg_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_export_jpg" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_share_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:text="@string/workspace_share" />
</LinearLayout>

<!-- CAMSCAN-PROD-008: PDF compression in the export row (stable semantic id
     export_compress_button). -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/export_compress_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/workspace_export_compress" />
</LinearLayout>

<!-- CAMSCAN-VERIFY-001: viewer tools row — the five P2 tool entries (stable
     semantic ids viewer_tool_sign_pad, viewer_tool_apply_signature,
     viewer_tool_annotate, viewer_tool_watermark, viewer_tool_protect). -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_tool_sign_pad"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/viewer_tool_sign_pad" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_tool_apply_signature"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/viewer_tool_apply_signature" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_tool_annotate"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/viewer_tool_annotate" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_tool_watermark"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:text="@string/viewer_tool_watermark" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewer_tool_protect"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:text="@string/viewer_tool_protect" />
</LinearLayout>

<!-- CAMSCAN-PROD-008: split page-selection bar (stable semantic ids
     document_split_confirm_button, document_split_cancel_button); gone
     until document_split_button enters selection mode. -->
<LinearLayout
    android:id="@+id/document_split_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/document_split_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/workspace_split_hint"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/document_split_selected_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/document_split_confirm_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/workspace_document_split_confirm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/document_split_cancel_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/workspace_document_split_cancel" />
    </LinearLayout>
</LinearLayout>
</LinearLayout>

<!-- CAMSCAN-VERIFY-001: PIN unlock overlay (stable semantic ids
     document_unlock_overlay, document_unlock_title, document_unlock_hint,
     document_unlock_pin, document_unlock_error, document_unlock_button);
     gone unless the document is PIN protected and this viewer instance has
     not verified the PIN yet. -->
<LinearLayout
    android:id="@+id/document_unlock_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/document_unlock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/viewer_unlock_title"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/document_unlock_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        android:text="@string/viewer_unlock_hint"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textColor="?android:attr/textColorSecondary" />

    <EditText
        android:id="@+id/document_unlock_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/viewer_unlock_pin_hint"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:maxLines="1" />

    <TextView
        android:id="@+id/document_unlock_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/viewer_unlock_wrong_pin"
        android:textAppearance="?attr/textAppearanceBody2"
        android:textColor="?android:attr/textColorPrimary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/document_unlock_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/viewer_unlock_button" />
</LinearLayout>
</FrameLayout>
