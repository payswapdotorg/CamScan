<?xml version="1.0" encoding="utf-8"?>
<!-- CAMSCAN-PROD-001 §6.5: the live scan surface.

     The scan_* ids are contract-frozen for ADB parity tests — do not rename:
     scan_camera_preview, scan_capture_button, scan_flash_toggle,
     scan_switch_camera, scan_permission_request_button,
     scan_permission_rationale, scan_unavailable_state, scan_done_button,
     plus the CAMSCAN-PROD-002 detection ids scan_framing_overlay and
     scan_detection_guidance, and the CAMSCAN-PROD-004 session id
     session_page_count_badge.

     Framework-only style attributes on purpose: the layout must inflate under
     any host theme (FragmentScenario included). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/scan_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/scan_preview_camera"
        app:implementationMode="compatible" />

    <!-- CAMSCAN-PROD-002 §6.6: live document framing overlay. Sits on top of
         the preview, under the controls; purely presentational (detection
         never gates capture). Transparent background keeps the preview
         fully visible; the three-state coloring comes from
         colors_capture.xml. -->
    <org.payswap.camscan.capture.detect.FramingOverlayView
        android:id="@+id/scan_framing_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/scan_framing_overlay_desc" />

    <!-- CAMSCAN-PROD-004 §6.6: session page-count tray (top-start badge).
         Shows "N pages" once the session holds pages; the multi-page loop's
         at-a-glance state. -->
    <TextView
        android:id="@+id/session_page_count_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@color/review_crop_scrim"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@android:color/white"
        android:contentDescription="@string/session_page_count_desc"
        android:visibility="gone" />

    <!-- CAMSCAN-PROD-002 §6.6: guidance line mapping the stable detection's
         quality flags to short scan_guidance_* copy. -->
    <TextView
        android:id="@+id/scan_detection_guidance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="104dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:padding="8dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@android:color/white"
        android:shadowColor="@android:color/black"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/scan_guidance_searching"
        android:contentDescription="@string/scan_guidance_searching" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/scan_flash_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/scan_flash_auto"
            android:contentDescription="@string/scan_flash_auto" />

        <Button
            android:id="@+id/scan_switch_camera"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/scan_switch_camera"
            android:contentDescription="@string/scan_switch_camera" />
    </LinearLayout>

    <Button
        android:id="@+id/scan_capture_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:minWidth="96dp"
        android:minHeight="48dp"
        android:enabled="false"
        android:text="@string/scan_capture"
        android:contentDescription="@string/scan_capture" />

    <Button
        android:id="@+id/scan_done_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:minHeight="48dp"
        android:visibility="gone"
        android:text="@string/scan_done"
        android:contentDescription="@string/scan_done" />

    <LinearLayout
        android:id="@+id/scan_permission_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/colorBackground"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/scan_permission_rationale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="@string/scan_permission_needed" />

        <Button
            android:id="@+id/scan_permission_request_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/scan_permission_request"
            android:contentDescription="@string/scan_permission_request" />
    </LinearLayout>

    <TextView
        android:id="@+id/scan_unavailable_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="@string/scan_unavailable"
        android:visibility="gone" />

</FrameLayout>
