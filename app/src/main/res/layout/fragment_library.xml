<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical">

<androidx.appcompat.widget.Toolbar
android:id="@+id/library_toolbar"
android:layout_width="match_parent"
android:layout_height="?attr/actionBarSize"
android:background="?attr/colorPrimary"
app:navigationIcon="?attr/homeAsUpIndicator"
app:title="@string/workspace_library_title"
app:titleTextColor="?attr/colorOnPrimary" />

<FrameLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1">

<androidx.recyclerview.widget.RecyclerView
android:id="@+id/library_documents_list"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:clipToPadding="false"
android:paddingBottom="8dp"
android:visibility="gone" />

<LinearLayout
android:id="@+id/library_empty_state"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:gravity="center"
android:orientation="vertical"
android:padding="32dp">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:gravity="center"
android:text="@string/workspace_library_empty_message"
android:textAppearance="?attr/textAppearanceBody1" />
</LinearLayout>
</FrameLayout>

<!-- CAMSCAN-PROD-008: import + merge entry row (stable semantic ids
     library_import_button, library_merge_button). -->
<LinearLayout
android:id="@+id/library_action_row"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:paddingStart="16dp"
android:paddingEnd="16dp"
android:paddingTop="8dp"
android:paddingBottom="8dp">

<com.google.android.material.button.MaterialButton
android:id="@+id/library_import_button"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginEnd="4dp"
android:layout_weight="1"
android:text="@string/workspace_library_import" />

<com.google.android.material.button.MaterialButton
android:id="@+id/library_merge_button"
style="@style/Widget.MaterialComponents.Button.OutlinedButton"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="4dp"
android:layout_weight="1"
android:text="@string/workspace_library_merge" />
</LinearLayout>

<!-- CAMSCAN-PROD-008: merge selection-mode bar (stable semantic ids
     library_merge_confirm_button, library_merge_cancel_button). -->
<LinearLayout
android:id="@+id/library_merge_bar"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:paddingStart="16dp"
android:paddingEnd="16dp"
android:paddingBottom="8dp"
android:visibility="gone">

<TextView
android:id="@+id/library_merge_hint"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:paddingBottom="8dp"
android:text="@string/workspace_library_merge_hint"
android:textAppearance="?attr/textAppearanceBody2"
android:textColor="?android:attr/textColorSecondary" />

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal">

<com.google.android.material.button.MaterialButton
android:id="@+id/library_merge_confirm_button"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginEnd="4dp"
android:layout_weight="1"
android:enabled="false"
android:text="@string/workspace_library_merge_confirm" />

<com.google.android.material.button.MaterialButton
android:id="@+id/library_merge_cancel_button"
style="@style/Widget.MaterialComponents.Button.OutlinedButton"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="4dp"
android:layout_weight="1"
android:text="@string/workspace_library_merge_cancel" />
</LinearLayout>
</LinearLayout></LinearLayout>
