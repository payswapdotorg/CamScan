{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lab/parity-ledger/ledger.schema.json",
  "title": "CamScan parity ledger (v0.1)",
  "description": "Machine-readable truth for scenario parity status. The ledger is the source of truth; scenario YAML status fields are human-readable mirrors. Validated in CI by tools/lab-cli/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "updated_by", "statuses", "blocked_dependencies", "resolved_dependencies", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "minLength": 1 },
    "statuses": {
      "type": "array",
      "const": ["UNKNOWN", "DISCOVERED", "SPECIFIED", "IMPLEMENTED", "PARTIAL", "BLOCKED", "PASS"]
    },
    "blocked_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "since", "reason", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
          "since": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "resolved_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resolved", "resolution", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
          "resolved": { "type": "string", "format": "date-time" },
          "resolution": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "title", "status", "capability", "owner", "last_run", "evidence", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{3}$" },
          "scenario": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["UNKNOWN", "DISCOVERED", "SPECIFIED", "IMPLEMENTED", "PARTIAL", "BLOCKED", "PASS"]
          },
          "capability": { "type": "string", "minLength": 1 },
          "owner": { "type": ["string", "null"] },
          "last_run": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["utc", "side", "provider", "emulator_acceleration"],
                "properties": {
                  "utc": { "type": "string", "format": "date-time" },
                  "side": { "enum": ["reference", "implementation", "both"] },
                  "provider": { "type": "string", "minLength": 1 },
                  "emulator_acceleration": { "enum": ["none", "kvm", "hvf"] },
                  "run_id": { "type": ["string", "null"] },
                  "verdict": { "enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED", "NOT_OBSERVED", null] }
                }
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {
                "kind": { "enum": ["document", "report", "manifest", "diff", "verdict", "screenshot", "log"] },
                "ref": {
                  "anyOf": [
                    { "type": "string", "pattern": "^(lab|docs|app|tools)/" },
                    { "type": "string", "pattern": "^r2:camscan-parity-evidence/" },
                    { "type": "string", "pattern": "^https://" }
                  ]
                },
                "run_id": { "type": ["string", "null"] },
                "side": { "enum": ["reference", "implementation", null] },
                "note": { "type": ["string", "null"] }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
